{
  "name": "solbot3",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de trading spot sur Solana (Jupiter) — backtest → paper → dry-run → live encadré.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "solbot3": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.json\"",
    "web:build": "npm --prefix web ci --no-audit --no-fund && npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "web:test": "npm --prefix web run test"
  },
  "dependencies": {
    "@solana/web3.js": "^3.1.1",
    "bs58": "^6.0.0",
    "commander": "^15.0.0",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
