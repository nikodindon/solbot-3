# ── Wallet (généré par `npm run solbot3 -- init` — ne jamais partager) ──
BS58_PRIVATE_KEY=

# ── Jupiter ────────────────────────────────────────────────────
JUPITER_API_KEY=
JUPITER_RPS=

# ── Solana RPC ─────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_FALLBACK_URL=

# ── Données historiques ────────────────────────────────────────
GECKO_API_KEY=

# ── Telegram (optionnel) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Dashboard (optionnel mais recommandé si exposé) ───────────
DASHBOARD_TOKEN=

# ── Divers ─────────────────────────────────────────────────────
LOG_LEVEL=info
